rules_version = '2';

// Easy Apartment — Firestore security rules
// Layout:
//   users/{uid}                         profile + the properties this user belongs to
//   properties/{pid}                    one per building; members map {uid: 'owner'|'assistant'|'viewer'}
//   properties/{pid}/{collection}/{id}  rooms, tenants, leases, bookings, meterReadings, bills, payments, expenses, maintenance
//   properties/{pid}/auditLogs/{id}     append-only history of every change
//   properties/{pid}/roomNights/{roomId_yyyy-mm-dd}   one doc per booked night → no double booking
//   properties/{pid}/counters/{name_yyyymm}           running document numbers
//   properties/{pid}/topups/{id}        subscription payments (server only)
//   publicBills/{token}                 bill snapshot for the link sent to tenants (get by token only)
//   invites/{code}, joinRequests/{pid_uid}   assistant invitations approved by the owner
//   lineLinks/{code}                    one-time codes a tenant sends to the LINE bot to link their account (server consumes)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function prop(pid) { return get(/databases/$(database)/documents/properties/$(pid)).data; }
    function roleIn(pid) { return prop(pid).members[request.auth.uid]; }
    function isMember(pid) { return signedIn() && request.auth.uid in prop(pid).members; }
    function isWriter(pid) { return isMember(pid) && roleIn(pid) in ['owner', 'assistant']; }
    function isOwner(pid) { return isMember(pid) && roleIn(pid) == 'owner'; }
    // Writable until the end of paidUntil day + 3 days grace; afterwards read-only.
    function isActive(pid) {
      let p = prop(pid);
      return p.paidUntil != null && request.time < p.paidUntil + duration.value(4, 'd');
    }
    function businessCollection(coll) {
      return coll in ['rooms', 'tenants', 'leases', 'bookings', 'meterReadings', 'bills', 'payments', 'expenses', 'maintenance'];
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /properties/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Sign-up / add building: the creator becomes the only owner; subscription fields start empty.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'address', 'promptpayId', 'accountName',
             'docPrefix', 'plan', 'paidUntil', 'introUsed', 'ownerUid', 'members', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.plan == 'pro'
        && request.resource.data.paidUntil == null
        && request.resource.data.introUsed == false;

      // Owners edit branding, invoice details and members (and stay owner); plan / paidUntil / introUsed change on the server.
      allow update: if signedIn()
        && resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'phone', 'address', 'promptpayId', 'accountName', 'docPrefix',
                       'nameEn', 'preparedBy', 'payMethod', 'accountNo', 'payReference', 'payNote', 'lineId', 'lineUrl',
                       'photo', 'elecCostPerUnit', 'waterCostPerUnit', 'defaultElecRate', 'defaultWaterRate', 'defaultDueDay',
                       'members', 'memberNames']);

      allow delete: if false;

      match /{coll}/{id} {
        allow read: if isMember(pid);
      }

      match /{coll}/{id} {
        allow create, update: if businessCollection(coll) && isWriter(pid) && isActive(pid);
        allow delete: if businessCollection(coll) && isOwner(pid) && isActive(pid);
      }

      // History can be added, never changed or removed.
      match /auditLogs/{id} {
        allow create: if isWriter(pid) && request.resource.data.actorUid == request.auth.uid;
      }

      // A night can be taken once: create only, never overwritten. Cancel = delete.
      match /roomNights/{night} {
        allow create, delete: if isWriter(pid) && isActive(pid);
      }

      match /counters/{name} {
        allow create: if isWriter(pid) && isActive(pid) && request.resource.data.value == 1;
        allow update: if isWriter(pid) && isActive(pid) && request.resource.data.value == resource.data.value + 1;
      }

      // topups: read via the generic read rule above; writes only through the Admin SDK.
    }

    match /publicBills/{token} {
      allow get: if token.size() >= 24;
      allow list: if false;
      allow create, update: if token.size() >= 24
        && isWriter(request.resource.data.propertyId) && isActive(request.resource.data.propertyId);
      allow delete: if isWriter(resource.data.propertyId);
    }

    // ── Assistants: owner makes a code, the assistant redeems it, the owner approves ──
    match /invites/{code} {
      allow create: if code.size() >= 8 && isOwner(request.resource.data.propertyId)
        && request.resource.data.role in ['assistant', 'viewer'];
      allow get: if signedIn();
      allow list: if false;
      allow delete: if isOwner(resource.data.propertyId);
    }

    match /joinRequests/{id} {
      function invite() { return get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data; }
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.propertyId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.code))
        && invite().propertyId == request.resource.data.propertyId
        && invite().role == request.resource.data.role
        && invite().expiresAt > request.time;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isOwner(resource.data.propertyId));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner(resource.data.propertyId));
    }

    // ── LINE: one-time link codes; the server (Admin SDK) consumes them ──
    match /lineLinks/{code} {
      allow create: if code.size() >= 6 && isWriter(request.resource.data.propertyId);
      allow read, delete: if isMember(resource.data.propertyId);
    }
  }
}
