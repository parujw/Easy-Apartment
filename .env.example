# Not needed for the real project: the easy-apartment web config is built into src/lib/firebase.ts.
# Use this only to develop against local emulators without touching real data:
#   npx firebase emulators:start --only auth,firestore --project demo-easy-apartment
NEXT_PUBLIC_USE_EMULATORS=1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-easy-apartment
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
